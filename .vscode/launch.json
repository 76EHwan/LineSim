{
  // F5 launches LineSim 3D Session directly (Release build with full PDB debug symbols).
  // - 1 / 2 / 3 / 4: Run drive 1-4
  // - N: Generate & load a fresh random 1.5x Finals Championship course (9.15m x 7.32m, 65-85m, 2+ crossings)
  // - R: Reset robot to start line
  // - Breakpoints in firmware/Main/Src/*.c and sim/**/*.cpp work directly.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LineSim",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Release/linesim.exe",
      "args": [
        "view",
        "--session",
        "scenarios/finals_1_5x_championship.json",
        "--complex",
        "--out",
        "runs/latest"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "LineSim: Build (Release)"
    }
  ]
}
