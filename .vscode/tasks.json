{
  // Ctrl+Shift+B: build.   Terminal > Run Task...: the LineSim tasks below.
  // The run tasks open the 3D window. Results go to runs/latest (index.html, summary.json, ...).
  // Cross-platform support for Windows (MSVC) and Linux (GitHub Codespaces / iPad via Wine).
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "LineSim: Build (Release)",
      "type": "process",
      "windows": {
        "command": "${env:SystemRoot}\\System32\\cmd.exe",
        "args": ["/d", "/c", "${workspaceFolder}\\build.bat", "Release"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/build_mingw.sh"]
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: Build (Debug)",
      "type": "process",
      "windows": {
        "command": "${env:SystemRoot}\\System32\\cmd.exe",
        "args": ["/d", "/c", "${workspaceFolder}\\build.bat", "Debug"]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/build_mingw.sh"]
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: 3D session",
      "detail": "Keep driving in the 3D window: 1-4 start a drive, arrows edit parameters, N = new random course",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\build\\Release\\linesim.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/linesim"
      },
      "args": ["view", "--session", "--track", "${input:track}", "--robot", "robots/full.json", "--out", "runs/latest",
               "--set", "base_mps=${input:baseSpeed}", "--set", "max_mps=${input:maxSpeed}", "--set", "accel=${input:accel}", "--set", "decel=${input:decel}", "${input:extraArgs}"],
      "dependsOn": "LineSim: Build (Release)",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: 3D scenario",
      "detail": "A scenario file (fixed drives) in the 3D window",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\build\\Release\\linesim.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/linesim"
      },
      "args": ["view", "${input:scenario}", "--out", "runs/latest",
               "--set", "base_mps=${input:baseSpeed}", "--set", "max_mps=${input:maxSpeed}", "--set", "accel=${input:accel}", "--set", "decel=${input:decel}", "${input:extraArgs}"],
      "dependsOn": "LineSim: Build (Release)",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: 3D interactive firmware menu",
      "detail": "Boots to the firmware menu; arrows = U/D/L/R buttons, Enter = K",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\build\\Release\\linesim.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/linesim"
      },
      "args": ["view", "--interactive", "--track", "${input:track}", "--robot", "robots/full.json", "--out", "runs/latest"],
      "dependsOn": "LineSim: Build (Release)",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: Generate random course",
      "detail": "tracks/random_<seed>.json, ZETIN rules (R 25 cm, 45 deg steps, right-angle crossings)",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\build\\Release\\linesim.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/linesim"
      },
      "args": ["gen", "${input:genArgs}"],
      "dependsOn": "LineSim: Build (Release)",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: Run scenario (no window)",
      "detail": "Headless, as fast as possible; output in runs/latest",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\build\\Release\\linesim.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/linesim"
      },
      "args": ["run", "${input:scenario}", "--out", "runs/latest",
               "--set", "base_mps=${input:baseSpeed}", "--set", "max_mps=${input:maxSpeed}", "--set", "accel=${input:accel}", "--set", "decel=${input:decel}", "${input:extraArgs}"],
      "dependsOn": "LineSim: Build (Release)",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true, "focus": true }
    },
    {
      "label": "LineSim: Open results in browser",
      "type": "process",
      "windows": {
        "command": "${env:SystemRoot}\\explorer.exe",
        "args": ["${workspaceFolder}\\runs\\latest\\index.html"]
      },
      "linux": {
        "command": "python3",
        "args": ["${workspaceFolder}/tools/serve_report.py"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "LineSim: Check open course (rules / closure)",
      "detail": "python tools/course.py on the track JSON that is open in the editor",
      "type": "shell",
      "command": "python",
      "args": ["tools/course.py", "${file}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "LineSim: Import Full.step (robot model)",
      "detail": "robots/Full.step -> robots/full.json + robots/mesh/*.stl (needs tools/.venv)",
      "type": "process",
      "windows": {
        "command": "${workspaceFolder}\\tools\\.venv\\Scripts\\python.exe",
        "args": ["tools/step_import.py", "robots/Full.step", "--total-mass", "0.4"]
      },
      "linux": {
        "command": "python3",
        "args": ["tools/step_import.py", "robots/Full.step", "--total-mass", "0.4"]
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "track",
      "type": "pickString",
      "description": "Course (random = a new ZETIN-rule course every time)",
      "options": [
        "tracks/hyper_straight_speedway.json",
        "tracks/zetin_finals_championship.json",
        "tracks/complex_grand_prix.json",
        "tracks/extreme_challenge.json",
        "random",
        "tracks/practice_board.json",
        "tracks/figure8.json",
        "tracks/oval.json"
      ],
      "default": "tracks/hyper_straight_speedway.json"
    },
    {
      "id": "scenario",
      "type": "pickString",
      "description": "Scenario",
      "options": [
        "scenarios/hyper_straight_speedway.json",
        "scenarios/zetin_finals_championship.json",
        "scenarios/complex_grand_prix.json",
        "scenarios/extreme_challenge.json",
        "scenarios/practice_board.json",
        "scenarios/figure8_all.json",
        "scenarios/oval_first.json"
      ],
      "default": "scenarios/hyper_straight_speedway.json"
    },
    { "id": "baseSpeed", "type": "promptString", "description": "base speed [m/s] (driveData.base_mps)", "default": "2.20" },
    { "id": "maxSpeed", "type": "promptString", "description": "max speed on straights [m/s] (driveData.max_mps, drives 2 and 4)", "default": "10.0" },
    { "id": "accel", "type": "promptString", "description": "acceleration [m/s^2] (driveData.accel)", "default": "7.5" },
    { "id": "decel", "type": "promptString", "description": "deceleration [m/s^2] (driveData.decel)", "default": "7.0" },
    { "id": "tuneSpeed", "type": "promptString", "description": "target speed [m/s] to tune steer kp / kd for (takes a few minutes)", "default": "2.20" },
    {
      "id": "extraArgs",
      "type": "promptString",
      "description": "Extra arguments, e.g. --complex --set steer_kp=20 --set steer_kd=500 --speed 0.5 --drives 1,4 (empty = none)",
      "default": ""
    },
    {
      "id": "genArgs",
      "type": "promptString",
      "description": "Generator options: --complex (고난도 다중교차/시케인 모드) --seed n --board 6.1x4.88 --crossings n --out tracks/my.json (empty = new seed)",
      "default": "--complex"
    }
  ]
}
